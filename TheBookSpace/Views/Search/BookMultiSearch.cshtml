<div class="modal" id="BookMultiSearchModal">
    <div class="row">
        <div class="form-group col-xl-4 col-md-12 col-lg-4 col-sm-12">
            <label for="Name">Name</label>
            <div class="input-group">
                <input type="text" class="form-control input-sm" id="Name" tabindex="1" />
            </div>
        </div>
        <div class="form-group col-xl-4 col-md-12 col-lg-4 col-sm-12">
            <label for="Series">Series</label>
            <div class="input-group">
                <input type="text" class="form-control input-sm" id="Series" tabindex="2" />
            </div>
        </div>
        <div class="form-group col-xl-2 col-md-2 col-lg-2 col-sm-12">
            <label for="btnAuthorSearch">.</label>
            <div class="input-group">
                <button class="btn btn-pink form-control" onclick="BookSearch()" id="btnAuthorSearch">Search</button>
            </div>
        </div>
    </div>
    <table id="tblBook" class="table table-striped table-bordered table-td-valign-middle" style="width:100%">
        <thead>
            <tr>
                <th></th>
                <th>Book Name</th>
                <th>Author</th>
                <th>Series</th>
                <th>Publisher</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
    <div class="div-centerbtn">
        <button id="btnAddBook" onclick="AddBook();" class="btn btn-green col-sm-12 col-md-12 col-lg-2 col-xl-2"><i class="fa fa-plus"></i>&nbsp;<span class="buttontext" id="btnText">Add Books</span></button>
    </div>
</div>

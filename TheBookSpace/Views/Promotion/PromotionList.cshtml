
@{
    ViewBag.Title = "PromotionList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="panel panel-inverse">
    <div class="panel-heading" style="text-align: center;">
        <h4 class="panel-title">Promotion List</h4>
        <div class="panel-heading-btn">
            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
        </div>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="form-group col-xl-3 col-md-3 col-lg-3 col-sm-12">
                <label for="Name">Promotion Name</label>
                <div class="input-group">
                    <input type="text" class="form-control input-sm" id="Name" tabindex="1" />
                </div>
            </div>
            <div class="form-group col-xl-2 col-md-2 col-lg-2 col-sm-12">
                <label for="btnPromotionSearch">.</label>
                <div class="input-group">
                    <button class="btn btn-pink form-control" onclick="PromotionSearch()" id="btnPromotionSearch">Search</button>
                </div>
            </div>
        </div>
        <table id="tblPromotion" class="table table-striped table-bordered table-td-valign-middle" style="width:100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Promotion Type</th>
                    <th>Promotion Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<input id="HGetPromotion" type="hidden" value="@Url.Action("GetPromotion", "api/PromotionApi")" />
<input id="HPromotionEntry" type="hidden" value="@Url.Action("PromotionEntry", "Promotion")" />
@section Scripts{
    <script src="@Url.Content("~/AdminScripts/promotion.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            PromotionListLoad();
        });
    </script>
}




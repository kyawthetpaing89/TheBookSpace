@model TBS_Model.PromotionModel
@{
    ViewBag.Title = "PromotionEntry";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-inverse">
    <div class="panel-heading" style="text-align: center;">
        <h4 class="panel-title">Promotion Entry</h4>
        <div class="panel-heading-btn">
            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
        </div>
    </div>
    <div class="panel-body">
        <div id="promotionbody" class="row">
            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="form-group required">
                    <label>Name</label>
                    @Html.TextBoxFor(x => x.PromotionName, new { @tabIndex = 1, @maxlength = 50, @class = "form-control" })
                </div>
            </div>
            <div class="col-lg-2 col-md-12 col-sm-12">
                <div class="form-group required">
                    <label>Promotion Percent</label>
                    @Html.TextBoxFor(x => x.PromotionPercent, new { @tabIndex = 1, @maxlength = 50, @class = "form-control promotionpercent align-right" })
                </div>
            </div>
            <div class="col-lg-2 col-md-12 col-sm-12">
                <div class="form-group required">
                    <label>Start Date</label>
                    @Html.TextBoxFor(x => x.PromotionStartDate, new { @tabIndex = 1, @maxlength = 50, @class = "form-control align-center" })
                </div>
            </div>
            <div class="col-lg-2 col-md-12 col-sm-12">
                <div class="form-group required">
                    <label>End Date</label>
                    @Html.TextBoxFor(x => x.PromotionEndDate, new { @tabIndex = 1, @maxlength = 50, @class = "form-control align-center" })
                </div>
            </div>
            <div class="form-group col-xl-3 col-md-12 col-lg-3 col-sm-12" style="padding-left:10px;padding-right:10px">
                <label for="Type">Promotion Type</label>
                <div class="input-group">
                    <select class="form-control input-sm" tabindex="2" id="PromotionType">
                        <option value="1">Selected Books</option>
                        <option value="2">Series</option>
                        <option value="3">Category</option>
                        <option value="4">Author/Illustrator</option>
                        <option value="5">Publisher</option>
                    </select>
                </div>
            </div>
            <div class="form-group col-xl-2 col-md-2 col-lg-2 col-sm-12">
                <label for="btnPromotionBookSearch">.</label>
                <div class="input-group">
                    <button class="btn btn-pink form-control" onclick="PromotionBookSearch()" id="btnPromotionBookSearch">Search</button>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-xl-12 col-md-12 col-lg-12 col-sm-12">
                <table id="tblPromotion" class="table table-striped table-bordered table-td-valign-middle" style="width:100%">
                    <thead>
                        <tr>
                            <th class="hide"></th>
                            <th class="hide"></th>
                            <th></th>
                            <th>Promotion By</th>
                            <th>Name</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.Partial(Url.Content("~/Views/Search/BookMultiSearch.cshtml"))
@Html.Partial(Url.Content("~/Views/Search/SeriesMultiSearch.cshtml"))
@Html.Partial(Url.Content("~/Views/Search/PublisherMultiSearch.cshtml"))
@Html.Partial(Url.Content("~/Views/Search/AuthorMultiSearch.cshtml"))
@Html.Partial(Url.Content("~/Views/Search/CategoryMultiSearch.cshtml"))

@Html.HiddenFor(x => x.Mode)
@Html.HiddenFor(x => x.PromotionCD)
@Html.HiddenFor(x => x.PromotionStatus)


<input id="HPromotionCUD" type="hidden" value="@Url.Action("PromotionCUD", "api/PromotionApi")" />
<input id="HGetPromotion" type="hidden" value="@Url.Action("GetPromotion", "api/PromotionApi")" />
<input id="HGetAuthor" type="hidden" value="@Url.Action("GetAuthor", "api/AuthorApi")" />
<input id="HGetPublisher" type="hidden" value="@Url.Action("GetPublisher", "api/PublisherApi")" />
<input id="HGetSeries" type="hidden" value="@Url.Action("GetSeries", "api/SeriesApi")" />
<input id="HGetCategory" type="hidden" value="@Url.Action("GetCategory", "api/CategoryApi")" />
<input id="HGetBook" type="hidden" value="@Url.Action("GetBook", "api/BookApi")" />
<input id="HPromotionList" type="hidden" value="@Url.Action("PromotionList", "Promotion")" />
@section Scripts{
    <script src="@Url.Content("~/AdminScripts/promotion.js")"></script>
    <script src="@Url.Content("~/AdminScripts/authormultisearch.js")"></script>
    <script src="@Url.Content("~/AdminScripts/publishermultisearch.js")"></script>
    <script src="@Url.Content("~/AdminScripts/seriesmultisearch.js")"></script>
    <script src="@Url.Content("~/AdminScripts/categorymultisearch.js")"></script>
    <script src="@Url.Content("~/AdminScripts/bookmultisearch.js")"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            PromotionEntryLoad();
        });
    </script>
}


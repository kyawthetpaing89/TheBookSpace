@model TBS_Model.SeriesModel
@{
    ViewBag.Title = "SeriesEntry";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-inverse">
    <div class="panel-heading" style="text-align: center;">
        <h4 class="panel-title">Series Entry</h4>
        <div class="panel-heading-btn">
            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
        </div>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-lg-3 col-md-12 col-sm-12">
                <div class="form-group required">
                    <label>Name</label>
                    @Html.TextBoxFor(x => x.SeriesName, new { @tabIndex = 1, @maxlength = 50, @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="div-centerbtn">
            <button id="btnSave" onclick="SeriesSaveClick();" class="btn btn-green col-sm-12 col-md-12 col-lg-2 col-xl-2"><i class="fa fa-save"></i>&nbsp;<span class="buttontext" id="btnText">Save</span></button>
        </div>
    </div>
</div>
@Html.HiddenFor(x => x.Mode)
@Html.HiddenFor(x => x.SeriesCD)
<input id="HSeriesCUD" type="hidden" value="@Url.Action("SeriesCUD", "api/SeriesApi")" />
<input id="HGetSeries" type="hidden" value="@Url.Action("GetSeries", "api/SeriesApi")" />
<input id="HSeriesList" type="hidden" value="@Url.Action("SeriesList", "Series")" />
@section Scripts{
    <script src="@Url.Content("~/AdminScripts/series.js")"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            SeriesEntryLoad();
        });
    </script>
}


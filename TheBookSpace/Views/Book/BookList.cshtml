
@{
    ViewBag.Title = "BookList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-inverse">
    <div class="panel-heading" style="text-align: center;">
        <h4 class="panel-title">Book List</h4>
        <div class="panel-heading-btn">
            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" data-click="panel-expand"><i class="fa fa-expand"></i></a>
        </div>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="form-group col-xl-4 col-md-12 col-lg-4 col-sm-12">
                <label for="Name">Name</label>
                <div class="input-group">
                    <input type="text" class="form-control input-sm" id="Name" tabindex="1" />
                </div>
            </div>
            <div class="form-group col-xl-2 col-md-12 col-lg-2 col-lg-2 col-sm-12">
                <label for="Category">Category</label>
                <div class="input-group">
                    <select class="form-control input-sm" tabindex="2" id="Category">
                        <option value=""></option>
                    </select>
                </div>
            </div>
            <div class="form-group col-xl-2 col-md-12 col-lg-2 col-sm-12">
                <label for="Language">Language</label>
                <div class="input-group">
                    <select class="form-control input-sm" tabindex="3" id="Language">
                        <option value=""></option>
                        <option value="1">English</option>
                        <option value="2">Japanese</option>
                    </select>
                </div>
            </div>
            <div class="form-group col-xl-3 col-md-12 col-lg-3 col-sm-12">
                <label for="Series">Series</label>
                <div class="input-group">
                    <input type="hidden" id="SeriesCD" />
                    <button id="btinSeriesSearch" tabindex="6" onclick="ShowSeriesSearchModal()" type="button" class="btn btn-pink"><i class="fa fa-search"></i></button>
                    <input type="text" class="form-control input-sm" id="SeriesName" disabled tabindex="1" />
                    <button id="btinSeriesClear" tabindex="7" onclick="SeriesClear()" type="button" class="btn btn-danger"><i class="fa fa-arrow-left"></i></button>
                </div>
            </div>
            <div class="form-group col-xl-3 col-md-12 col-lg-3 col-sm-12">
                <label for="Publisher">Publisher</label>
                <div class="input-group">
                    <input type="hidden" id="PublisherCD" />
                    <button id="btinPublisherSearch" tabindex="8" onclick="ShowPublisherSearchModal()" type="button" class="btn btn-pink"><i class="fa fa-search"></i></button>
                    <input type="text" class="form-control input-sm" id="PublisherName" disabled tabindex="1" />
                    <button id="btinPublisherClear" tabindex="9" onclick="PublisherClear()" type="button" class="btn btn-danger"><i class="fa fa-arrow-left"></i></button>
                </div>
            </div>
            <div class="form-group col-xl-3 col-md-12 col-lg-3 col-sm-12">
                <label for="Author1">Author 1</label>
                <div class="input-group">
                    <input type="hidden" id="AuthorCD1" />
                    <button id="btinAuthorSearch" tabindex="10" onclick="ShowAuthorSearchModal(1)" type="button" class="btn btn-pink"><i class="fa fa-search"></i></button>
                    <input type="text" class="form-control input-sm" id="AuthorName1" disabled tabindex="1" />
                    <button id="btnAuthorClear1" tabindex="11" onclick="AuthorClear(1)" type="button" class="btn btn-danger"><i class="fa fa-arrow-left"></i></button>
                </div>
            </div>
            <div class="form-group col-xl-3 col-md-12 col-lg-3 col-sm-12">
                <label for="Illustrator1">Illustrator 1</label>
                <div class="input-group">
                    <input type="hidden" id="IllustratorCD1" />
                    <button id="btnIllustrator1Search" tabindex="16" onclick="ShowIllustratorSearchModal(1)" type="button" class="btn btn-pink"><i class="fa fa-search"></i></button>
                    <input type="text" class="form-control input-sm" id="IllustratorName1" disabled tabindex="1" />
                    <button id="btnIllustratorClear1" tabindex="17" onclick="IllustratorClear(1)" type="button" class="btn btn-danger"><i class="fa fa-arrow-left"></i></button>
                </div>
            </div>
            <div class="form-group col-xl-2 col-md-2 col-lg-2 col-sm-12">
                <label for="btnBookSearch">.</label>
                <div class="input-group">
                    <button class="btn btn-pink form-control" onclick="BookSearch()" id="btnBookSearch">Search</button>
                </div>
            </div>
        </div>
        <table id="tblBook" class="table table-striped table-bordered table-td-valign-middle" style="width:100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Cover Image</th>
                    <th>Name</th>
                    <th>Author</th>
                    <th>Series</th>
                    <th>Publisher</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<input type="hidden" id="AuthorNo" />
<input type="hidden" id="IllustratorNo" />


@Html.Partial(Url.Content("~/Views/Search/SeriesSearch.cshtml"))
@Html.Partial(Url.Content("~/Views/Search/PublisherSearch.cshtml"))
@Html.Partial(Url.Content("~/Views/Search/AuthorSearch.cshtml"))

<input id="HGetBook" type="hidden" value="@Url.Action("GetBook", "api/BookApi")" />
<input id="HBookEntry" type="hidden" value="@Url.Action("BookEntry", "Book")" />
<input id="HGetAuthor" type="hidden" value="@Url.Action("GetAuthor", "api/AuthorApi")" />
<input id="HGetCategory" type="hidden" value="@Url.Action("GetCategory", "api/CategoryApi")" />
<input id="HGetSeries" type="hidden" value="@Url.Action("GetSeries", "api/SeriesApi")" />
<input id="HGetPublisher" type="hidden" value="@Url.Action("GetPublisher", "api/PublisherApi")" />
@section Scripts{
    <script src="@Url.Content("~/AdminScripts/book.js")"></script>
    <script src="@Url.Content("~/AdminScripts/seriessearch.js")"></script>
    <script src="@Url.Content("~/AdminScripts/publishersearch.js")"></script>
    <script src="@Url.Content("~/AdminScripts/authorsearch.js")"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            BookListLoad();
        });
    </script>
}

